

# -----------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------
ENVIRONMENT=development
DEBUG=True
# production → DEBUG=False
AUDIO_DEVICE_NAME=alsa_input.usb-C-Media_Electronics_Inc._USB_PnP_Sound_Device-00.analog-mono
# -----------------------------------------------------
# LLM (AI BRAIN)
# -----------------------------------------------------
# Provider options: openai | anthropic | google | openrouter
LLM_PROVIDER=openrouter

# OpenRouter (recommended: cheap + fast models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Try later: meta-llama/llama-3.1-8b-instruct

# Model behaviour tuning
LLM_MODEL=gpt-3.5-turbo          # fallback name (some routers ignore this)
LLM_MAX_TOKENS=150               # 80–150 = fast conversational robot
LLM_TEMPERATURE=0.7              # 0.5 = factual | 0.8 = expressive
LLM_MAX_HISTORY=10               # keep short for speed + memory safety

# -----------------------------------------------------
# SPEECH-TO-TEXT (STT)
# -----------------------------------------------------
# Provider options:
# soniox   → best for Malayalam (10.7% WER) - RECOMMENDED
# deepgram → fast cloud (English/Hindi only, NO Malayalam)
# sarvam   → fast cloud Indic STT
# google   → free, supports Malayalam
# whisper  → offline / fallback
SPEECH_PROVIDER=google
STT_USE_STREAMING=false            # Use streaming for lower latency

# ---- Soniox (BEST FOR MALAYALAM) ----
# Excellent Malayalam support with 10.7% WER (vs Google 42%, Deepgram N/A)
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-preview       # Real-time streaming model
SONIOX_LANGUAGE_HINTS=ml,en       # Malayalam + English (comma-separated)
SONIOX_SPEAKER_DIARIZATION=false  # Enable speaker separation
SONIOX_ENDPOINT_DETECTION=true    # Auto-detect speech endpoints

# ---- Deepgram (ENGLISH/HINDI ONLY) ----
# NOTE: Deepgram does NOT support Malayalam!
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2             # fastest + most accurate
DEEPGRAM_LANGUAGE=en              # English only (no Malayalam support)
DEEPGRAM_SMART_FORMAT=false       # punctuation, numbers, formatting

# ---- Sarvam AI (Indic STT & TTS) ----
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
SARVAM_MODE=transcribe            # translate, transcribe, verbatim, translit, codemix
SARVAM_TTS_SPEAKER=ratan          # ratan, meera, shubh, aravind, etc.
SARVAM_TTS_PACE=1.0               # Speed of voice (0.5 to 2.0)

# ---- Whisper (LOCAL FALLBACK) ----
WHISPER_MODEL=base                # tiny=fast | base=balanced | small=better
WHISPER_LANGUAGE=auto             # auto = Malayalam + English
WHISPER_DEVICE=cpu                # cuda if NVIDIA GPU exists

# -----------------------------------------------------
# TEXT-TO-SPEECH (VOICE)
# -----------------------------------------------------
# Provider options:
# sarvam → fast cloud Indic TTS (Malayalam/English) - bulbul:v3
# piper  → local, Malayalam friendly, fastest offline
# openai → cloud, English premium
TTS_PROVIDER=piper
TTS_LANGUAGE=ml_IN                 # auto switches ML / EN

# ---- Piper (Local Malayalam Voice) ----
PIPER_BINARY_PATH=tools/piper/piper
PIPER_MODEL_PATH=data/models/piper/ml_IN-arjun-medium.onnx

# Voice tuning
PIPER_NOISE_SCALE=0.667            # lower = robotic | higher = expressive
PIPER_NOISE_W=0.8                  # phoneme width variation

# Speaking behaviour
TTS_SPEAKING_RATE=1.1              # 1.0 normal | 1.1 energetic | 1.2 child-like
TTS_VOLUME_GAIN_DB=0.0

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=NNl6r8mD7vthiJatiJt1  # Antoni (Male)
ELEVENLABS_MODEL=eleven_v3   # Best for Malayalam

# -----------------------------------------------------
# AUDIO INPUT (MIC)
# -----------------------------------------------------
AUDIO_SAMPLE_RATE=16000            # REQUIRED for most STT engines
AUDIO_CHANNELS=1                  # mono
AUDIO_DEVICE_NAME=default         # change only if mic not detected`

# -----------------------------------------------------
# ROBOT HARDWARE
# -----------------------------------------------------
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# Servo safety limits
SERVO_MIN_ANGLE=90
SERVO_MAX_ANGLE=130

# -----------------------------------------------------
# LOGGING
# -----------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FILE=data/logs/robot.log 7b1b50ae9162143825f6747de2da402e1b72

# Operator Control
TELEGRAM_BOT_TOKEN=8237274142:AAH5QYKnGy1BFHAVIEQ64GLJ_7hhRTwK
TELEGRAM_ENABLED=true  # Set to false to disable Telegramm8ooo