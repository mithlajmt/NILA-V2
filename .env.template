

# -----------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------
ENVIRONMENT=development
DEBUG=True
# production → DEBUG=False

# -----------------------------------------------------
# LLM (AI BRAIN)
# -----------------------------------------------------
# Provider options: openai | anthropic | google | openrouter
LLM_PROVIDER=openrouter

# OpenRouter (recommended: cheap + fast models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Try later: meta-llama/llama-3.1-8b-instruct

# Model behaviour tuning
LLM_MODEL=gpt-3.5-turbo          # fallback name (some routers ignore this)
LLM_MAX_TOKENS=150               # 80–150 = fast conversational robot
LLM_TEMPERATURE=0.7              # 0.5 = factual | 0.8 = expressive
LLM_MAX_HISTORY=10               # keep short for speed + memory safety

# -----------------------------------------------------
# SPEECH-TO-TEXT (STT)
# -----------------------------------------------------
# Provider options:
# deepgram → fastest cloud (recommended)
# whisper  → offline / fallback
SPEECH_PROVIDER=deepgram

# ---- Deepgram (FAST MODE) ----
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2             # fastest + most accurate
DEEPGRAM_LANGUAGE=ml             # forced Malayalam
DEEPGRAM_SMART_FORMAT=false        # punctuation, numbers, formatting

# ---- Whisper (LOCAL FALLBACK) ----
WHISPER_MODEL=base                # tiny=fast | base=balanced | small=better
WHISPER_LANGUAGE=ml             # forced Malayalam
WHISPER_DEVICE=cpu                # cuda if NVIDIA GPU exists

# -----------------------------------------------------
# TEXT-TO-SPEECH (VOICE)
# -----------------------------------------------------
# Provider options:
# piper  → local, Malayalam friendly, fastest offline
# openai → cloud, English premium
TTS_PROVIDER=piper
TTS_LANGUAGE=ml                 # forced Malayalam

# ---- Piper (Local Malayalam Voice) ----
PIPER_BINARY_PATH=tools/piper/piper
PIPER_MODEL_PATH=data/models/piper/ml_IN-arjun-medium.onnx

# Voice tuning
PIPER_NOISE_SCALE=0.667            # lower = robotic | higher = expressive
PIPER_NOISE_W=0.8                  # phoneme width variation

# Speaking behaviour
TTS_SPEAKING_RATE=1.1              # 1.0 normal | 1.1 energetic | 1.2 child-like
TTS_VOLUME_GAIN_DB=0.0

# -----------------------------------------------------
# AUDIO INPUT (MIC)
# -----------------------------------------------------
AUDIO_SAMPLE_RATE=16000            # REQUIRED for most STT engines
AUDIO_CHANNELS=1                  # mono
AUDIO_DEVICE_NAME=default         # change only if mic not detected

# -----------------------------------------------------
# ROBOT HARDWARE
# -----------------------------------------------------
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# Servo safety limits
SERVO_MIN_ANGLE=90
SERVO_MAX_ANGLE=130

# -----------------------------------------------------
# LOGGING
# -----------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FILE=data/logs/robot.log 7b1b50ae9162143825f6747de2da402e1b72
